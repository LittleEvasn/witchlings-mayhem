extends SceneTree
const Spells = preload("res://scripts/spells.gd")
var g: Node2D
var checks := 0
var failures := 0
func _initialize() -> void: call_deferred("run")
func check(ok: bool, message: String) -> void:
 checks += 1
 if not ok:
  failures += 1
  printerr("FAIL: "+message)
 else: print("PASS: "+message)
func reset() -> void:
 g.start_run("sigil")
 g.set_physics_process(false)
 g.sound_enabled = false
 g.player.position = Vector2(400,400)
 g.cast_target = Vector2(520,400)
 g.meter = preload("res://scripts/combat_meter.gd").new()
func target(at := Vector2(520,400), health := 10000.0, boss := false) -> Node2D:
 var e: Node2D = g.Actor.new()
 g.actors.add_child(e)
 e.setup(g.art,1,boss)
 e.position = at
 e.hp = health
 e.max_hp = health
 e.radius = 16
 e.speed = 50
 g.enemies.append(e)
 g._rebuild_grid()
 return e
func shoot(recipe: Array) -> void:
 var r := Spells.compile(recipe)
 check(r.ok,"Compile "+str(recipe))
 if r.ok: g.emit_stage(r.stages[0],g.player.position,Vector2.RIGHT,r.stages[1] if r.stages.size()>1 else {},1.0)
func step(seconds: float) -> void:
 for i in ceili(seconds*120):
  g._rebuild_grid()
  g._update_projectiles(1.0/120)
  g.magic.update_zones(1.0/120)
func run() -> void:
 g = load("res://scenes/main.tscn").instantiate()
 root.add_child(g)
 current_scene = g
 reset()
 g.result_win = true
 g.start_run()
 check(not g.result_win,"Restart clears previous victory state")
 check(Spells.PARTS.size()==22 and g.Economy.PRICES.size()==22,"22 unique definitions and prices")
 for recipe in [["graft","bolt"],["seek","frost"],["pierce","thunder"],["echo","satellite"],["bounce","ember_path"]]: check(Spells.compile(recipe).ok,"Universal modifier supported: "+str(recipe))
 check(not Spells.compile(["bolt","on_return","bloom"]).ok,"Return connector needs a returning attack")
 check(is_equal_approx(Spells.interval(Spells.compile(["charge","bolt","impact","charge","bloom"]).stages),1.44),"Charge cadence penalty applied once across stages")
 for kit in g.Economy.KITS:
  g.start_run(kit)
  check(g.economy.owns_recipe(g.recipe) and Spells.compile(g.recipe).ok,"Kit owns valid starting recipe "+kit)
  check(g.cast_clock>0 and g.economy.gold==0,"First shot has full cadence and no extra money "+kit)
 reset()
 var e := target()
 shoot(["charge","bolt","impact","bloom"])
 check(is_equal_approx(g.projectiles[0].damage,66),"Charge triples primary base damage")
 step(0.4)
 check(g.meter.totals.get("damage_raw",0)<100,"Primary charge not inherited by child")
 reset()
 e = target()
 for i in 3:
  shoot(["frost"])
  step(0.3)
 check(g.magic.behavior.movement_factor(e)==0,"Three cold hits freeze ordinary enemy")
 var before: float = e.hp
 shoot(["shatter","bolt"])
 step(0.4)
 check(is_equal_approx(before-e.hp,52),"Frozen target consumes shell for 22+30 damage")
 check(g.meter.totals.get("shatters",0)==1,"Shell shatters once")
 for i in 3: shoot(["frost"])
 check(g.magic.behavior.movement_factor(e)>0,"Refreeze grace keeps movement possible")
 reset()
 e = target(Vector2(520,400),10000,true)
 for i in 3: shoot(["frost"])
 check(g.magic.behavior.movement_factor(e)>0 and g.magic.behavior.state_for(e).frozen_until>0,"Boss remains mobile with breakable shell")
 reset()
 e = target()
 for i in 6:
  shoot(["sigil","frost"])
  step(0.3)
 check(g.meter.totals.get("sigil_bursts",0)==1,"Six cast lineages create one sigil burst")
 reset()
 e = target()
 shoot(["sigil","frost"])
 step(3.1)
 check(g.meter.totals.get("marks_expired",0)==1,"Unused marks expire after three seconds")
 reset()
 e = target()
 shoot(["thunder"])
 step(0.3)
 check(e.hp==10000,"Thunder advertises before damage")
 step(0.2)
 check(is_equal_approx(e.hp,9964),"Thunder strikes chosen point after delay")
 reset()
 e = target()
 shoot(["thunder","impact","bolt"])
 step(0.6)
 check(g.metrics.triggers==1,"Thunder group first impact creates exactly one child")
 reset()
 shoot(["frost","expire","bolt"])
 check(g.metrics.triggers==1 and g.projectiles.size()==1,"Cone normal end can trigger without victims")
 reset()
 shoot(["boomerang","on_return","bolt"])
 step(1.5)
 check(g.metrics.triggers==1,"Return connector fires on actual catch")
 reset()
 shoot(["boomerang","on_return","bolt"])
 g.projectiles[0].life = 0.001
 step(0.02)
 check(g.metrics.triggers==0,"Return connector never fires on timeout")
 reset()
 shoot(["bolt","expire","bloom"])
 g.projectiles[0].pos = Vector2(1700,400)
 step(0.02)
 check(g.metrics.triggers==0,"Boundary removal does not trigger normal expiry")
 reset()
 for i in 3:
  shoot(["graft","vortex"])
  g.projectiles.back().pos = Vector2(600,400)
  g.magic.install(g.projectiles.back())
  g.projectiles.clear()
  step(0.3)
 check(g.magic.zones.size()==1 and g.magic.zones[0].tier==3,"Three inputs mature one fixed-center graft field")
 check(g.magic.zones[0].life<5.2,"Grafting never refreshes lifetime")
 check(g.meter.totals.get("graft_matured",0)==1,"Mature bonus applied once")
 shoot(["graft","vortex"])
 g.projectiles.back().pos = Vector2(600,400)
 g.magic.install(g.projectiles.back())
 g.projectiles.clear()
 check(g.magic.zones.size()==2,"Mature field rejects further investment")
 step(6.1)
 check(g.magic.zones.is_empty(),"Grafted fields finish within six seconds")
 reset()
 shoot(["fan","echo","graft","vortex"])
 for p in g.projectiles:
  p.pos = Vector2(600,400)
  g.magic.install(p)
 g.projectiles.clear()
 step(0.2)
 for p in g.projectiles:
  p.pos = Vector2(600,400)
  g.magic.install(p)
 g.projectiles.clear()
 check(g.magic.zones.size()==1 and g.magic.zones[0].mass<=1.001,"Fan and echo share growth cap and merge config")
 reset()
 shoot(["sigil","satellite","expire","bolt"])
 shoot(["satellite"])
 shoot(["satellite"])
 check(g.magic.behavior.orbits.size()==2,"Orbit set count bounded without force eviction")
 step(2)
 check(g.metrics.triggers==1,"Orbit expiry is once per set")
 reset()
 for i in 20:
  g.player.position.x += 25
  step(0.06)
 shoot(["ember_path","expire","bolt"])
 check(g.magic.zones.size()<=4,"Recent movement emits at most four trail patches")
 step(2)
 check(g.metrics.triggers==1,"Trail expires once per complete group")
 reset()
 for i in 15: shoot(["ember_path","expire","bolt"])
 check(g.magic.zones.size()==12,"Trail has independent twelve-patch cap")
 check(g.metrics.triggers==0,"Evicted trails create no expiry chain")
 g.clear_magic()
 check(g.magic.zones.is_empty() and g.magic.behavior.orbits.is_empty() and g.magic.behavior.statuses.is_empty() and g.magic.behavior.strikes.is_empty(),"Cleanup clears states, delayed strikes and fields")
 reset()
 g.economy.gold = 500
 g.economy.roll(g.rng,g.recipe)
 check(g.economy.select_research("graft",g.economy.revision),"Research can select exact desired component")
 check(g.economy.buy(0,g.economy.revision),"Research purchase adds owned item")
 g.economy.reroll(g.rng,g.recipe)
 check(g.economy.research_sold and not g.economy.select_research("frost",g.economy.revision),"Reroll cannot reset research purchase")
 g.economy.inventory["graft"] = 4
 check(not g.economy.can_stock("graft"),"Four copies cover both attack groups on both orbs")
 reset()
 g.economy.inventory["charge"] = 1
 shoot(["bolt"])
 g.open_editor()
 g.draft = ["charge","bolt"]
 var n: int = g.projectiles.size()
 check(g.apply_recipe() and n>0 and g.projectiles.size()==n,"Combat apply preserves in-flight snapshots")
 var remaining: float = g.cast_clock
 g.open_editor()
 g.apply_recipe()
 check(is_equal_approx(g.cast_clock,remaining),"Unchanged apply does not reset charge")
 g.complete_wave()
 g.choose_reward("power")
 g.draft = ["charge","bolt"]
 check(g.start_trial(),"New spell starts trial from shop")
 var seconds: float = g.shop_time
 var wave_seconds: float = g.wave_time
 g._physics_process(0.1)
 check(g.shop_time==seconds and g.wave_time==wave_seconds,"Trial freezes shop and wave clocks")
 g.undo_draft()
 g.end_trial()
 check(g.enemies.is_empty() and g.magic.behavior.statuses.is_empty(),"Trial exit clears dummy status and attacks")
 reset()
 e = target(Vector2(520,400),5)
 var neighbor := target(Vector2(540,400),1000)
 var c: Dictionary = g.magic.behavior.context(Spells.compile(["sigil","frost"]).stages[0],Vector2(400,400),Vector2.RIGHT,{},1,1,"primary",false,100,0)
 var status: Dictionary = g.magic.behavior.state_for(e)
 status.mark_mass = 5
 status.marks = [{"mass":5.0,"power":1.0}]
 g.magic.behavior.hit(e,10,Vector2.ZERO,c)
 check(e.dead and neighbor.hp==958,"Killing hit completing six marks bursts at death position")
 reset()
 e = target()
 c = g.magic.behavior.context(Spells.compile(["sigil","bolt"]).stages[0],Vector2(400,400),Vector2.RIGHT,{},1,1,"primary",false,101,0)
 for i in 20:
  g.magic.behavior.hit(e,1,Vector2.ZERO,c)
  step(0.26)
 check(is_equal_approx(g.meter.totals.get("marks_added",0),2),"Continuous contact cannot exceed two mark mass per original cast")
 reset()
 e = target()
 for i in 3: shoot(["frost"])
 var start_hp: float = e.hp
 shoot(["fan","shatter","thunder"])
 step(0.5)
 check(g.meter.totals.get("shatters",0)==1 and start_hp>e.hp,"Overlapping thunder lobes cannot consume one frozen shell twice")
 reset()
 e = target(Vector2(520,400),10)
 for i in 3:
  var cold_state: Dictionary = g.magic.behavior.state_for(e)
  cold_state.frozen_until = g.magic.behavior.clock+1
 c = g.magic.behavior.context(Spells.compile(["shatter","bolt"]).stages[0],Vector2(400,400),Vector2.RIGHT,{},1,1,"primary",false,102,0)
 g.magic.behavior.hit(e,22,Vector2.ZERO,c)
 check(g.meter.totals.get("kills",0)==1 and g.meter.totals.get("damage_overkill",0)==42,"Lethal base hit records shatter as overkill, not a second kill")
 reset()
 e = target(Vector2(520,400))
 shoot(["seek","thunder"])
 step(0.2)
 e.position = Vector2(600,400)
 step(0.11)
 var locked: Vector2 = g.magic.behavior.strikes[0].points[0].pos
 e.position = Vector2(700,400)
 step(0.2)
 check(locked.x==600 and e.hp==10000,"Tracked thunder locks during final 0.15s and can miss")
 reset()
 for i in 2:
  shoot(["graft","thorn","expire","bolt"])
  g.projectiles.back().pos = Vector2(600,400)
  g.magic.install(g.projectiles.back())
  g.projectiles.clear()
 e = target(Vector2(600,400))
 step(0.4)
 check(e.hp==10000,"Unripe graft thorn ignores ordinary proximity activation")
 step(5.7)
 check(e.hp<=9910 and g.metrics.triggers==1,"Partial graft thorn detonates at lifetime and triggers once")
 reset()
 shoot(["graft","vortex"])
 g.projectiles.back().pos = Vector2(600,400)
 g.magic.install(g.projectiles.back())
 g.projectiles.clear()
 g.magic.generation += 1
 shoot(["graft","vortex"])
 g.projectiles.back().pos = Vector2(600,400)
 g.magic.install(g.projectiles.back())
 g.projectiles.clear()
 check(g.magic.zones.size()==2,"Different applied recipe generations never graft together")
 reset()
 e = target(g.player.position)
 shoot(["ember_path"])
 shoot(["charge","ember_path"])
 step(0.31)
 check(is_equal_approx(10000-e.hp,12),"Overlapping trail patches use strongest damage only")
 reset()
 shoot(["satellite","expire","bolt"])
 g.player.position += Vector2(80,0)
 step(0.1)
 check(g.magic.behavior.orbits[0].pos==g.player.position,"Primary orbit center follows player")
 g.clear_magic()
 shoot(["frost","expire","satellite"])
 var center: Vector2 = g.magic.behavior.orbits[0].pos
 g.player.position += Vector2(80,0)
 step(0.1)
 check(g.magic.behavior.orbits[0].pos==center,"Secondary orbit remains at trigger position")
 g.queue_free()
 await process_frame
 print("RESULT: %d checks / %d failures" % [checks,failures])
 quit(1 if failures else 0)
